# Frontend (Vite — inlined at build time)
# Leave empty for in-process API (tests / local UI-only).
VITE_API_BASE_URL=http://localhost:8787
# Optional. Only needed if Render sets DEMO_SECRET / CRON_SECRET.
VITE_DEMO_SECRET=

# Backend (Render / local `npm run dev:server`)
PORT=8787
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CRON_SECRET=
DEMO_SECRET=
NODE_ENV=development
